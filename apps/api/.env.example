# Sevyo API — environment variables (copy to .env, never commit) - NEVER SHARE WITH ANYONE
# Reference: SEVYO_WEBAPP_DOC.md §8

# MySQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="mysql://sevyo:sevyo_pass@localhost:3306/sevyo"

# JWT signing secrets (use long random strings in production)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Token lifetimes (vercel/ms format)
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Server
PORT=4000
NODE_ENV="development"

# Allowed frontend origin(s) for CORS (comma-separated)
CORS_ORIGIN="http://localhost:3000"

# Local disk path for MVP file uploads (relative to apps/api)
UPLOAD_DIR="uploads"

# Cookie scope (leave unset for localhost dev)
COOKIE_DOMAIN=""

# Razorpay keys — get test keys from dashboard.razorpay.com (Settings → API keys).
# Leave empty to disable online payment (users can still book with cash).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Local no-Docker database: `npm run db:local` (root) starts an ephemeral
# in-memory MySQL via mysql-memory-server and prints the matching DATABASE_URL.